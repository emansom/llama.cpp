%llguidance {}

# Apriel-1.6-Thinker chat grammar (Lark / llguidance)
#
# Wire format for the model's emitted assistant turn (after generation prompt
# `<|begin_assistant|>\nHere are my reasoning steps:\n` which is prepended to
# the parser input):
#   <reasoning>\n[BEGIN FINAL RESPONSE]\n<content>(<tool_calls>[json]</tool_calls>)?
#
# `<tool_calls>[...]</tool_calls>` is a JSON array of
# `{"name": "...", "arguments": {...}}` objects.

start: assistant_body

assistant_body: reasoning_block content tool_calls_block?

reasoning_block: reasoning "\n[BEGIN FINAL RESPONSE]\n"
reasoning: /(.|\n)*?/

content: /([^<]|<(?!tool_calls>))*/

tool_calls_block: "<tool_calls>[" tool_call_separator tool_call (tool_call_separator tool_call)* tool_call_separator? "]</tool_calls>"
tool_call_separator: "," json_ws | json_ws
tool_call: "{\"name\": \"" func_name "\", \"arguments\": " tool_args "}"

json_ws: /[ \t\n]*/
func_name: FUNC_NAME
FUNC_NAME: /[a-zA-Z_][a-zA-Z0-9_]*/
tool_args: {{TOOL_SCHEMA}}
