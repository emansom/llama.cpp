%llguidance {}

# Cohere c4ai Command-R chat grammar (Lark / llguidance)
#
# Wire format for the model's emitted assistant turn:
#   <|START_THINKING|><reasoning><|END_THINKING|>
#       (<|START_ACTION|>[json_tool_call_objs]<|END_ACTION|>
#        | <|START_RESPONSE|><content><|END_RESPONSE|>)
#
# The tool action block is a JSON array of objects shaped as
#   {"tool_call_id": "STR", "tool_name": "STR", "parameters": {json}}
# Modeled as a structured rule so the parser can identify tool_call_id /
# tool_name / parameters even when the JSON tail is incomplete (partial
# generation mode).
#
# Two named entries:
#   - `start` (default) --- assistant-turn continuation; sampler entry.
#   - `conversation` --- full conversation wire shape.
#
# {{TOOL_SCHEMA}} is replaced at runtime with the JSON-object matcher.

start: assistant_body

# --- Assistant turn continuation (sampler entry) -------------------------------
# Split into explicit `with_thinking` / `without_thinking` branches. PEG
# ordered choice commits to `with_thinking` as soon as `<|START_THINKING|>`
# matches, so the optional-thinking prefix can't be silently dropped during
# partial parsing (avoids reasoning-content regression in streaming-prefix
# monotonicity tests).
assistant_body: with_thinking | without_thinking
with_thinking: think_block (tool_action_block | response_block)
without_thinking: tool_action_block | response_block

think_block: "<|START_THINKING|>" reasoning "<|END_THINKING|>"
reasoning: /([^<]|<(?!\|END_THINKING\|))*/

# Structured tool-call rule: lark-to-peg auto-tags `tool_call` as `tool`,
# `func_name` as `tool-name`, `tool_id` as `tool-id`, and `tool_args` as
# `tool-args`. Each tool call emits per-rule events incrementally, enabling
# partial parsing to surface tool_call_id + tool_name + tool_args text as
# the JSON arrives.
tool_action_block: "<|START_ACTION|>[" json_ws tool_call (tool_call_separator tool_call)* json_ws "]<|END_ACTION|>"
tool_call_separator: "," json_ws
tool_call: "{\"tool_call_id\": \"" tool_id "\", \"tool_name\": \"" func_name "\", \"parameters\": " tool_args "}"

# JSON whitespace between array elements (commas, newlines, indentation).
json_ws: /[ \t\n]*/
tool_id: /[a-zA-Z0-9_-]*/
func_name: FUNC_NAME
FUNC_NAME: /[a-zA-Z_][a-zA-Z0-9_]*/
tool_args: {{TOOL_SCHEMA}}

response_block: "<|START_RESPONSE|>" content "<|END_RESPONSE|>"
content: /([^<]|<(?!\|END_RESPONSE\|))*/

# --- Full-conversation walker entry --------------------------------------------
conversation: turn+ assistant_open?
turn: system_turn | user_turn | chatbot_turn

system_turn:   "<|START_OF_TURN_TOKEN|><|SYSTEM_TOKEN|>"  turn_body_text "<|END_OF_TURN_TOKEN|>"
user_turn:     "<|START_OF_TURN_TOKEN|><|USER_TOKEN|>"    turn_body_text "<|END_OF_TURN_TOKEN|>"
chatbot_turn:  "<|START_OF_TURN_TOKEN|><|CHATBOT_TOKEN|>" turn_body_text "<|END_OF_TURN_TOKEN|>"
assistant_open: "<|START_OF_TURN_TOKEN|><|CHATBOT_TOKEN|>"

turn_body_text: /([^<]|<(?!\|END_OF_TURN_TOKEN\|))*/
