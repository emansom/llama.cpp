%llguidance {}

# DeepSeek v3.2 chat grammar (Lark / llguidance)
#
# Covers the full output format for tool-call, content-only, and response_format responses.
# Tool call format:    XML-like DSML tags
# Response format:     think_block? content ```json\n{schema}\n```
#
# {{RESPONSE_SCHEMA}} replaced at runtime with %json {schema}.

start: think_block? content (tool_calls_block | response_format | )
think_block: "<think>" reasoning "</think>"
reasoning: /(.|\n)*?/
content: /([^<`]|<(?!｜DSML｜function_calls)|`[^`]|``[^`])*/

DSML: "｜DSML｜"
WS: /[ \t\n]+/
tool_calls_block: "<" DSML "function_calls>" WS? tool_call (WS? tool_call)* WS? "</" DSML "function_calls>"
tool_call: "<" DSML "invoke" WS "name=\"" func_name "\">" WS? arg* "</" DSML "invoke>"
func_name: FUNC_NAME
FUNC_NAME: /[a-zA-Z_][a-zA-Z0-9_]*/
arg: "<" DSML "parameter" WS "name=\"" arg_name "\"" WS "string=\"" BOOL_STR "\">" arg_value "</" DSML "parameter>" WS?
arg_name: /[a-zA-Z_][a-zA-Z0-9_]*/
BOOL_STR: "true" | "false"
arg_value: /[^<]*/

response_format: "```json\n" response_content "\n```"
response_content: {{RESPONSE_SCHEMA}}
