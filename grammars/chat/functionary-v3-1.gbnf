# Meetkai Functionary medium v3.1 chat grammar (GBNF)

root ::= assistant-body
assistant-body ::= tool-call-block | content

content ::= ( [^<] | "<" [^f] )*

tool-call-block ::= tool-call ( tool-call )*
tool-call ::= "<function=" func-name ">" tool-args "</function>"

func-name ::= [a-zA-Z_] [a-zA-Z0-9_]*
tool-args ::= "{" ( [^}] | "{" [^}]* "}" )* "}"
