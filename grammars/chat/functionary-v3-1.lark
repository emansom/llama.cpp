%llguidance {}

# Meetkai Functionary medium v3.1 chat grammar (Lark / llguidance)
#
# Wire format for the model's emitted assistant turn:
#   <content>(<function=NAME>{json}</function>)*
#
# Tool calls use the `<function=NAME>{args_json}</function>` wire shape. No
# reasoning channel. The grammar permits content-only OR one-or-more tool
# calls with no leading content; tool calls run back-to-back without a
# separator between them.

start: assistant_body

assistant_body: tool_call_block | content

content: /([^<]|<(?!function=))*/

tool_call_block: tool_call+
tool_call: "<function=" func_name ">" tool_args "</function>"

func_name: FUNC_NAME
FUNC_NAME: /[a-zA-Z_][a-zA-Z0-9_]*/
tool_args: {{TOOL_SCHEMA}}
