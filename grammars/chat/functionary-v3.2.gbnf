# Functionary v3.2 chat grammar (GBNF)
#
# Covers the full output format for both tool-call and content-only responses.
# Tool call format: >>>function_name\n{json_args}

root ::= content-part? tool-calls?
content-part ::= content ">>>"
content ::= ( [^>] | ">" [^>] | ">>" [^>] )*

tool-calls ::= tool-call+
tool-call ::= func-name "\n" tool-args
func-name ::= [a-zA-Z_] [a-zA-Z0-9_]*
tool-args ::= "{" ( [^}] | "{" [^}]* "}" )* "}"
