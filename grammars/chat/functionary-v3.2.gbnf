# Functionary v3.2 chat grammar (GBNF)
#
# Two named entries:
#   - `root` (default) — assistant-turn continuation; sampler entry.
#     Tool call format: >>>function_name\n{json_args}
#   - `conversation` — full conversation wire shape; selected via arena
#     set_root() by the bidirectional walker.

root ::= content-part? tool-calls?
content-part ::= content ">>>"
content ::= ( [^>] | ">" [^>] | ">>" [^>] )*

tool-calls ::= tool-call+
tool-call ::= func-name "\n" tool-args
func-name ::= [a-zA-Z_] [a-zA-Z0-9_]*
tool-args ::= "{" ( [^}] | "{" [^}]* "}" )* "}"

# --- Full-conversation walker entry ---
conversation ::= turn+ assistant-open?
turn ::= system-turn | user-turn | tool-result-turn | assistant-full-turn
system-turn ::= "<|start_header_id|>system<|end_header_id|>\n\n" turn-body-text "<|eot_id|>"
user-turn ::= "<|start_header_id|>user<|end_header_id|>\n\n" turn-body-text "<|eot_id|>"
tool-result-turn ::= "<|start_header_id|>tool<|end_header_id|>\n\n" turn-body-text "<|eot_id|>"
assistant-full-turn ::= "<|start_header_id|>assistant<|end_header_id|>\n\n>>>" turn-body-text "<|eot_id|>"
assistant-open ::= "<|start_header_id|>assistant<|end_header_id|>\n\n>>>"

turn-body-text ::= ( [^<] | "<" [^|] | "<|" [^e] | "<|e" [^o] )*
