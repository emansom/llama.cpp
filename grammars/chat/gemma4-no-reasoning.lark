%llguidance {}

# Gemma 4 chat grammar — parser-side variant for `reasoning_format = NONE`.
#
# Mirrors `gemma4.lark` for tool-call and response-format turn shapes,
# but treats the `<|channel>thought ... <channel|>` block as content
# (markers preserved verbatim) rather than extracting it as reasoning.
# Selected by `init_gemma4` when
# `inputs.reasoning_format == COMMON_REASONING_FORMAT_NONE`.
#
# {{RESPONSE_SCHEMA}} replaced at runtime with %json {schema}.

# The thought-block-as-content shape uses the `analysis_content` rule
# convention introduced for the no-reasoning variants: the body is captured
# in a tagged 'analysis_content' rule, the literal channel-marker open and
# close are matched in the enclosing 'think_block' rule and re-injected by
# the format consumer's analysis_marker_open / analysis_marker_close.
start: think_block? content (tool_calls | response_format | )
think_block: "<|channel>thought" analysis_content "<channel|>"
analysis_content: /(.|\n)*?/

# Generation entry for entry_state IN_REASONING: the prompt ended inside an
# unclosed thought, so the delta opens in the MIDDLE of the thought body, the
# `<|channel>thought` opener having already been sent. Same role as
# `resume_reasoning` in gemma4.lark, and it MUST keep that name --
# common_chat_gemma4_entry_root maps the state to this rule name for both
# variants.
#
# NOTE: this file duplicates gemma4.lark and has drifted from it -- it still has
# the swallow-everything `turn_body_text`, the global `%ignore`, and the per-tag
# content lookaheads that gemma4.lark replaced. The two variants differ in ONE
# thing: whether a thought surfaces as reasoning or as content with its markers
# kept. That is a transformer decision, not a grammar one -- the transformer
# already receives reasoning_format and other formats branch on it there. Folding
# these into a single grammar is the right fix; it needs the streaming-partial
# marker semantics settled first, so it is not done here.
resume_reasoning: analysis_content "<channel|>" content (tool_calls | response_format | )
content: /([^<`]|<[^|]|<\|[^tc]|<\|t[^o]|<\|to[^o]|<\|too[^l]|<\|tool[^_]|<\|tool_[^c]|`[^`]|``[^`])*/

tool_calls: tool_call+
tool_call: "<|tool_call>call:" func_name gemma4_dict "<tool_call|>"
func_name: FUNC_NAME
FUNC_NAME: /[a-zA-Z_][a-zA-Z0-9_]*/

gemma4_dict: "{" (gemma4_kv ("," gemma4_kv)*)? "}"
gemma4_kv: gemma4_dict_key ":" gemma4_value
gemma4_dict_key: /[^:{}]+/
gemma4_value: gemma4_string | gemma4_dict | gemma4_array | GEMMA4_NUMBER | GEMMA4_BOOL | "null"
gemma4_string: "<|\"|>" GEMMA4_STR_CONTENT "<|\"|>"
GEMMA4_STR_CONTENT: /([^<]|<[^|]|<\|[^"]|<\|"[^|])*/
gemma4_array: "[" (gemma4_value ("," gemma4_value)*)? "]"

GEMMA4_NUMBER: /-?[0-9]+(\.[0-9]+)?([eE][+-]?[0-9]+)?/
GEMMA4_BOOL: "true" | "false"

response_format: "```json\n" response_content "\n```"
response_content: {{RESPONSE_SCHEMA}}

# --- Full-conversation walker entry --------------------------------------------
# Identical to `gemma4.lark` — the no-reasoning variant only changes how the
# assistant-turn `<|channel>thought` block is surfaced; the conversation wire
# shape is the same.
conversation: turn+ assistant_open?
turn: "<|turn>" role_name "\n" turn_body_text "<turn|>\n"
role_name: "system" | "user" | "model"
assistant_open: "<|turn>model\n" thought_open_marker?
thought_open_marker: "<|channel>thought\n<channel|>"

turn_body_text: /([^<]|<(?!turn\|>))*/

%ignore /[ \t\n\r]/
