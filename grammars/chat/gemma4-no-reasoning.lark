%llguidance {}

# Gemma 4 chat grammar — parser-side variant for `reasoning_format = NONE`.
#
# Mirrors `gemma4.lark` for tool-call and response-format turn shapes,
# but treats the `<|channel>thought ... <channel|>` block as content
# (markers preserved verbatim) rather than extracting it as reasoning.
# Selected by `init_gemma4` when
# `inputs.reasoning_format == COMMON_REASONING_FORMAT_NONE`.
#
# {{RESPONSE_SCHEMA}} replaced at runtime with %json {schema}.

# The thought-block-as-content shape uses the `analysis_content` rule
# convention introduced for the no-reasoning variants: the body is captured
# in a tagged 'analysis_content' rule, the literal channel-marker open and
# close are matched in the enclosing 'think_block' rule and re-injected by
# the format consumer's analysis_marker_open / analysis_marker_close.
start: think_block? content (tool_calls | response_format | )
think_block: "<|channel>thought" analysis_content "<channel|>"
analysis_content: /(.|\n)*?/
content: /([^<`]|<[^|]|<\|[^tc]|<\|t[^o]|<\|to[^o]|<\|too[^l]|<\|tool[^_]|<\|tool_[^c]|`[^`]|``[^`])*/

tool_calls: tool_call+
tool_call: "<|tool_call>call:" func_name gemma4_dict "<tool_call|>"
func_name: FUNC_NAME
FUNC_NAME: /[a-zA-Z_][a-zA-Z0-9_]*/

gemma4_dict: "{" (gemma4_kv ("," gemma4_kv)*)? "}"
gemma4_kv: gemma4_dict_key ":" gemma4_value
gemma4_dict_key: /[^:{}]+/
gemma4_value: gemma4_string | gemma4_dict | gemma4_array | GEMMA4_NUMBER | GEMMA4_BOOL | "null"
gemma4_string: "<|\"|>" GEMMA4_STR_CONTENT "<|\"|>"
GEMMA4_STR_CONTENT: /([^<]|<[^|]|<\|[^"]|<\|"[^|])*/
gemma4_array: "[" (gemma4_value ("," gemma4_value)*)? "]"

GEMMA4_NUMBER: /-?[0-9]+(\.[0-9]+)?([eE][+-]?[0-9]+)?/
GEMMA4_BOOL: "true" | "false"

response_format: "```json\n" response_content "\n```"
response_content: {{RESPONSE_SCHEMA}}

%ignore /[ \t\n\r]/
