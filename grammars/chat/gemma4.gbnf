# Gemma 4 chat grammar (GBNF)
#
# Covers the full output format for tool-call, content-only, and response_format responses.
# {{RESPONSE_SCHEMA}} replaced at runtime.

root ::= think-block? ( tool-calls | response-format | content )
content ::= ( [^<`] | "<" [^|] | "<|" [^tc] | "<|t" [^o] | "<|to" [^o] | "<|too" [^l] | "<|tool" [^_] | "<|tool_" [^c] | "`" [^`] | "``" [^`] )*
think-block ::= "<|channel>thought" [ \t\n\r]+ reasoning [^<]* "<channel|>"
reasoning ::= [^<]*

tool-calls ::= tool-call+
tool-call ::= "<|tool_call>call:" func-name gemma4-dict "<tool_call|>"
func-name ::= [a-zA-Z_] [a-zA-Z0-9_]*

gemma4-dict ::= "{" ( gemma4-kv ( "," gemma4-kv )* )? "}"
gemma4-kv ::= gemma4-dict-key ":" gemma4-value
gemma4-dict-key ::= [^:{}]+
gemma4-value ::= gemma4-string | gemma4-dict | gemma4-array | gemma4-number | "true" | "false" | "null"
gemma4-string ::= "<|\"|>" gemma4-str-content "<|\"|>"
gemma4-str-content ::= ( [^<] | "<" [^|] | "<|" [^"] | "<|\"" [^|] )*
gemma4-array ::= "[" ( gemma4-value ( "," gemma4-value )* )? "]"
gemma4-number ::= "-"? [0-9]+ ( "." [0-9]+ )? ( [eE] [+-]? [0-9]+ )?

response-format ::= "```json\n" response-content "\n```"
response-content ::= {{RESPONSE_SCHEMA}}
