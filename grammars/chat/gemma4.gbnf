# Gemma 4 chat grammar (GBNF)
#
# Covers the full output format for tool-call, content-only, and response_format responses.
# {{RESPONSE_SCHEMA}} replaced at runtime.

# No `root` rule: like gemma4.lark, this file is a library of productions and the
# entry is appended per request by common_chat_grammar_set_entry, because GBNF
# cannot be told which rule to start at either.
turn-start ::= think-block? ( tool-calls | response-format | content )
content ::= ( [^<`] | "<" [^|] | "<|" [^tc] | "<|t" [^o] | "<|to" [^o] | "<|too" [^l] | "<|tool" [^_] | "<|tool_" [^c] | "`" [^`] | "``" [^`] )*
think-block ::= "<|channel>thought" [ \t\n\r]+ reasoning [^<]* "<channel|>"
reasoning ::= [^<]*

# Entry rule when generation resumes INSIDE a prefilled thought (entry_state
# IN_REASONING). The model continues the thought body, closes it, then carries on
# with the turn -- the "<|channel>thought" opener is already in the prompt, so
# `root` (which expects that opener) is the wrong constraint there.
#
# Selected by chat_grammar_set_entry(), which rewrites `root` to reference this
# rule, because neither GBNF nor llguidance can be told which production to start
# at. Mirrors gemma4.lark's `resume_reasoning`, hyphenated per GBNF convention --
# chat_grammar_set_entry does that translation.
resume-reasoning ::= reasoning "<channel|>" ( tool-calls | response-format | content )

tool-calls ::= tool-call+
tool-call ::= "<|tool_call>call:" func-name gemma4-dict "<tool_call|>"
func-name ::= [a-zA-Z_] [a-zA-Z0-9_]*

gemma4-dict ::= "{" ( gemma4-kv ( "," gemma4-kv )* )? "}"
gemma4-kv ::= gemma4-dict-key ":" gemma4-value
gemma4-dict-key ::= [^:{}]+
gemma4-value ::= gemma4-string | gemma4-dict | gemma4-array | gemma4-number | "true" | "false" | "null"
gemma4-string ::= "<|\"|>" gemma4-str-content "<|\"|>"
gemma4-str-content ::= ( [^<] | "<" [^|] | "<|" [^"] | "<|\"" [^|] )*
gemma4-array ::= "[" ( gemma4-value ( "," gemma4-value )* )? "]"
gemma4-number ::= "-"? [0-9]+ ( "." [0-9]+ )? ( [eE] [+-]? [0-9]+ )?

response-format ::= "```json\n" response-content "\n```"
response-content ::= {{RESPONSE_SCHEMA}}

# --- Full-conversation walker entry ---
conversation ::= turn+ assistant-open?
turn ::= "<|turn>" role-name "\n" turn-body-text "<turn|>\n"
role-name ::= "system" | "user" | "model"
assistant-open ::= "<|turn>model\n" thought-open-marker?
thought-open-marker ::= "<|channel>thought\n<channel|>"

turn-body-text ::= ( [^<] | "<" [^t] | "<t" [^u] | "<tu" [^r] | "<tur" [^n] | "<turn" [^|] )*
