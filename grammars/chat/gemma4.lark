%llguidance {}

# Gemma 4 chat grammar (Lark / llguidance)
#
# Two named entries:
#   - `start` (default) — assistant-turn continuation; sampler entry. The model
#     emits an optional `<|channel>thought ...<channel|>` reasoning block, then
#     content, then either tool calls (`<|tool_call>call:NAME{args}<tool_call|>`)
#     or a `\`\`\`json` response_format block.
#   - `conversation` — full conversation wire shape; selected via arena
#     set_root() by the bidirectional walker.
#
# Conversation wire shape (per google-gemma-4-31B-it.jinja):
#   <|turn>system\n<system_body>[<|tool>...<tool|>]+<turn|>\n   (system + tool defs)
#   <|turn>user\n<user_body><turn|>\n
#   <|turn>model\n<assistant_body>[<|tool_call>...<tool_call|>]<turn|>\n
#                                  ^-- assistant body may contain <|channel>thought
#                                      <|tool_response>response:NAME{...}<tool_response|>
#   <|turn>model\n[<|channel>thought\n<channel|>]                     (generation prompt)
#
# {{RESPONSE_SCHEMA}} replaced at runtime with %json {schema}.

start: think_or_stray? content (think_block content)* (tool_calls | response_format | trailing_channel_marker | )

# --- Assistant turn continuation (sampler entry) -------------------------------
think_or_stray: think_block | stray_open
# Content is any run of text containing NO TAG.
#
# `<|` always begins a tag (open `<|NAME>` or self-delimiting `<|NAME|>`), and
# `<NAME|>` is a close tag, so both are excluded generically -- not by listing
# the tags someone remembered. A `<` that begins neither is ordinary text.
#
# This replaces a chain of per-tag negative lookaheads
# (`<(?!\|tool_call>)(?!channel\|>)(?!\|channel>thought)(?!\|channel>)`), which
# was permissive in the wrong direction: any tag not on that list fell through
# and was captured as content instead of failing. Now an unrecognised tag ends
# content and matches no production, which is a parse error -- the strictness
# the format is supposed to give. Adding a tag no longer means remembering to
# update this rule. See docs/fork/ARCHITECTURE.md.
#
# The backtick clauses are unrelated: they keep ``` from being swallowed so the
# response_format block can match.
content: /([^<`]|<(?!\|)(?![a-zA-Z_][a-zA-Z0-9_]*\|>)|`(?!``)|``(?!`))*/
think_block: "<|channel>thought" reasoning "<channel|>"
reasoning: /(.|\n)*?/
# Some Gemma 4 fixtures emit a stray '<|channel>' (without 'thought') at the
# start of the body. Match and discard it.
stray_open: "<|channel>"
# Some Gemma 4 fixtures emit trailing '<channel|>' after the body. Match
# and discard it so the strict closing-tokens-required policy still
# applies but the stray bytes don't surface as content.
trailing_channel_marker: "<channel|>"

tool_calls: tool_call+
tool_call: "<|tool_call>call:" func_name gemma4_dict "<tool_call|>"
func_name: FUNC_NAME
FUNC_NAME: /[a-zA-Z_][a-zA-Z0-9_]*/

gemma4_dict: "{" (gemma4_kv ("," gemma4_kv)*)? "}"
gemma4_kv: gemma4_dict_key ":" gemma4_value
gemma4_dict_key: /[^:{}]+/
gemma4_value: gemma4_string | gemma4_dict | gemma4_array | GEMMA4_NUMBER | GEMMA4_BOOL | "null"
gemma4_string: "<|\"|>" GEMMA4_STR_CONTENT "<|\"|>"
GEMMA4_STR_CONTENT: /([^<]|<[^|]|<\|[^"]|<\|"[^|])*/
gemma4_array: "[" (gemma4_value ("," gemma4_value)*)? "]"

GEMMA4_NUMBER: /-?[0-9]+(\.[0-9]+)?([eE][+-]?[0-9]+)?/
GEMMA4_BOOL: "true" | "false"

response_format: "```json\n" response_content "\n```"
response_content: {{RESPONSE_SCHEMA}}

# --- Full-conversation walker entry --------------------------------------------
#
# Real intra-turn structure, not an opaque catch-all. The walker runs the SAME
# pipeline over a rendered prompt that it runs over generation, so the decoder
# only emits events for constructs the grammar actually names. `turn_body_text`
# swallowing every turn body as text is why the walk could validate framing and
# still recover nothing.
#
# The assistant turn deliberately reuses `think_block`, `content` and
# `tool_calls` from the generation entry above: one description of the model's
# wire shape, used for both directions.

conversation: closed_turn* open_model_turn?

closed_turn: system_turn | user_turn | closed_model_turn

system_turn: "<|turn>system\n" opaque_body "<turn|>\n"
user_turn:   "<|turn>user\n"   opaque_body "<turn|>\n"

# A model turn that completed. It may end at <turn|> or, when it left tool calls
# outstanding, at a bare <|tool_response> -- both are required literals, not an
# optional closer (see POLICIES.md#closing-tokens-are-required).
closed_model_turn: "<|turn>model\n" model_body model_turn_close
model_turn_close: "<turn|>\n" | tool_response_block+

# The final, UNCLOSED model turn: where generation resumes. Walking it is what
# carries already-emitted content and reasoning into the output message.
#
# It has TWO shapes, because generation can resume in either of two places:
#
#   - inside the thought      -- the caller prefilled reasoning_content and the
#                                model is still thinking, so there is no
#                                <channel|> yet
#   - after the thought       -- the thought completed and the caller prefilled
#                                content, so the body is an ordinary model_body
#
# `open_thought` is NOT a loosened closer. <channel|> stays a required literal
# everywhere it can appear; this is a distinct wire shape in which it has not
# been emitted yet, expressed as its own alternative -- the exception spelled out
# in POLICIES.md#closing-tokens-are-required. Making think_block's closer
# optional instead would let the sampler skip it during generation, which is the
# failure that policy exists to prevent.
open_model_turn: "<|turn>model\n" open_model_body
open_model_body: open_thought | model_body

# A thought still in progress: opener required, body captured as reasoning, no
# closer because the model has not finished thinking.
#
# Reuses `reasoning` rather than naming a new rule: lark-to-peg tags a rule as
# REASONING by matching the name exactly ("reasoning" / "thought"), so
# `open_reasoning` would parse and then emit no reasoning event at all. Its
# non-greedy body has no following sibling here, so it runs to end of input --
# which is right, because an unfinished thought is the last thing in the prompt.
open_thought: "<|channel>thought\n" reasoning

# Same shape as the generation entry, so the same decoder tags fire.
model_body: think_or_stray? content (think_block content)* tool_calls?

tool_response_block: "<|tool_response>response:" func_name gemma4_dict "<tool_response|>"

# System and user bodies are not extracted -- nothing downstream reads them --
# so they stay opaque rather than inventing structure the decoder would ignore.
opaque_body: /([^<]|<(?!turn\|>))*/

# NO %ignore. Whitespace is significant in this format: content is returned to
# the caller verbatim, and a global skip silently ate the trailing space of a
# prefilled continuation ("Hello, " came back as "Hello,"). Every literal in
# this grammar spells out the whitespace it expects.
