# GigaChat v3 chat grammar (GBNF)
#
# Covers the full output format for both tool-call and content-only responses.
# Tool call format: <|message_sep|>\n\nfunction call<|role_sep|>\n{"name":"...","arguments":{...}}

root ::= content tool-call?
content ::= ( [^<] | "<" [^|] )*

tool-call ::= "<|message_sep|>\n\nfunction call<|role_sep|>\n" tool-body
tool-body ::= "{" "\"name\"" ":" "\"" func-name "\"" "," "\"arguments\"" ":" tool-args "}"
func-name ::= [a-zA-Z_] [a-zA-Z0-9_]*
tool-args ::= "{" ( [^}] | "{" [^}]* "}" )* "}"
