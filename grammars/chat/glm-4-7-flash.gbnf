# GLM-4.7-Flash chat grammar (GBNF)
#
# Two named entries:
#   - `root` (default) — assistant-turn continuation; sampler entry.
#   - `conversation` — full conversation wire shape; selected via arena
#     set_root() by the bidirectional walker.

root ::= think-block content tool-call-block?
think-block ::= "<think>" reasoning "</think>"
reasoning ::= [^<]*
content ::= ([^<] | "<" [^t/])*

tool-call-block ::= tool-call ( tool-call )*
tool-call ::= tool-open func-name tool-arg* tool-close
tool-open  ::= "<tool_call>"
tool-close ::= "</tool_call>"

func-name ::= [a-zA-Z_] [a-zA-Z0-9_]*

tool-arg ::= arg-key-open arg-name arg-key-close arg-value-open arg-value arg-value-close
arg-key-open    ::= "<arg_key>"
arg-key-close   ::= "</arg_key>"
arg-value-open  ::= "<arg_value>"
arg-value-close ::= "</arg_value>"
arg-name ::= [^<]+
arg-value ::= ([^<] | "<" [^/] | "</" [^a])*

# --- Full-conversation walker entry ---
conversation ::= prefix? turn+ assistant-open?
prefix ::= "[gMASK]<sop>"
turn ::= system-turn | user-turn | tool-observation-turn | assistant-full-turn

system-turn ::= "<|system|>" turn-body-text
user-turn ::= "<|user|>" turn-body-text
tool-observation-turn ::= "<|observation|>" turn-body-text
assistant-full-turn ::= "<|assistant|>" turn-body-text
assistant-open ::= "<|assistant|>"

# Turn body — stops at any role marker.
turn-body-text ::= ( [^<] | "<" [^|] | "<|" [^uaso] )*
