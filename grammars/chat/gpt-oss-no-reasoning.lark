%llguidance {}

# GPT-OSS chat grammar — parser-side variant for `reasoning_format = NONE`.
#
# Mirrors `gpt-oss.lark` for tool-call, response-format, builtin and
# content-turn shapes, but treats the analysis turn body as content
# (markers preserved verbatim) rather than extracting it as reasoning.
# Selected by `init_gpt_oss` when
# `inputs.reasoning_format == COMMON_REASONING_FORMAT_NONE`.

# Same multi-turn outer shape as the reasoning variant.
start: stray_to_assistant? turn (turn_separator stray_to_assistant? turn)*
turn_separator: "<|end|>" "<|start|>" "assistant"

stray_to_assistant: "<|channel|>commentary to=assistant"

turn: tool_call | builtin_tool_call | analysis_turn | response_format_turn | content_turn

# Function tool calls — recipient appears in either the role header or the channel header.
tool_call: function_role_first | function_channel_first
function_role_first: " to=functions." func_name "<|channel|>" channel_type constrain? "<|message|>" tool_args
function_channel_first: "<|channel|>" channel_type " to=functions." func_name constrain? "<|message|>" tool_args
func_name: FUNC_NAME
FUNC_NAME: /[a-zA-Z_][a-zA-Z0-9_]*/
tool_args: {{TOOL_SCHEMA}}

# Builtin tool calls.
builtin_tool_call: builtin_role_first | builtin_channel_first
builtin_role_first: " to=" builtin_recipient "<|channel|>" channel_type constrain? "<|message|>" builtin_body
builtin_channel_first: "<|channel|>" channel_type " to=" builtin_recipient constrain? "<|message|>" builtin_body
builtin_recipient: BUILTIN_RECIPIENT
BUILTIN_RECIPIENT: /[a-zA-Z_][a-zA-Z0-9_.\-]*/
builtin_body: /(.|\n)*?/

# Analysis turn — body captured as `analysis-content`. The literal channel
# markers are matched in the enclosing `analysis_turn` rule; the json-tagged
# decoder re-injects them via `analysis_marker_open()` / `analysis_marker_close()`.
analysis_turn: "<|channel|>analysis<|message|>" analysis_content
analysis_content: /(.|\n)*?/

# Response-format turn — schema-constrained JSON in the final channel.
response_format_turn: "<|channel|>final" constrain "<|message|>" response_content
response_content: {{RESPONSE_SCHEMA}}

# Content turn — final or commentary channel without a recipient.
content_turn: "<|channel|>" final_or_commentary "<|message|>" content
final_or_commentary: "final" | "commentary"
content: /(.|\n)*?/

channel_type: CHANNEL_TYPE
CHANNEL_TYPE: "commentary" | "analysis" | "final"

constrain: " "? "<|constrain|>" CONSTRAIN_TYPE
CONSTRAIN_TYPE: /[A-Za-z0-9_\-]+/
