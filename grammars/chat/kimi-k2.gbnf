# Kimi K2 chat grammar (GBNF)
#
# Two named entries:
#   - `assistant-body` — sampler entry; assistant-turn continuation. The
#     `root ::=` line points here so the GBNF sampler picks it up directly.
#   - `conversation` — full conversation wire shape; selected via arena
#     set_root() by the bidirectional pipeline.

root ::= assistant-body

# --- Assistant turn continuation (sampler entry) ---
assistant-body ::= think-block? content tool-calls-section?
think-block ::= "<think>" reasoning "</think>"
reasoning ::= ( [^<] | "<" [^/] | "</" [^t] )*
content ::= ( [^<] | "<" [^|] | "<|" [^t] )*

tool-calls-section ::= "<|tool_calls_section_begin|>"? tool-call+ "<|tool_calls_section_end|>"?
tool-call ::= "<|tool_call_begin|>" tool-id "<|tool_call_argument_begin|>" tool-args "<|tool_call_end|>"?
tool-id ::= "functions." func-name ":" call-index
func-name ::= [a-zA-Z_] [a-zA-Z0-9_]*
call-index ::= [0-9]+
tool-args ::= "{" ( [^}] | "{" [^}]* "}" )* "}"

# --- Full-conversation walker entry ---
conversation ::= tool-declare-turn? turn+ assistant-open?
turn ::= system-turn | user-turn | tool-result-turn | assistant-full-turn
tool-declare-turn ::= "<|im_system|>tool_declare<|im_middle|>" turn-body-text "<|im_end|>"
system-turn ::= "<|im_system|>system<|im_middle|>" turn-body-text "<|im_end|>"
user-turn ::= "<|im_user|>user<|im_middle|>" turn-body-text "<|im_end|>"
tool-result-turn ::= "<|im_system|>tool<|im_middle|>" turn-body-text "<|im_end|>"
assistant-full-turn ::= "<|im_assistant|>assistant<|im_middle|>" think-block? content-in-turn tool-calls-section? "<|im_end|>"
assistant-open ::= "<|im_assistant|>assistant<|im_middle|>"

# Body of a non-assistant turn — anything that isn't the start of <|im_end|>.
turn-body-text ::= ( [^<] | "<" [^|] | "<|" [^i] | "<|i" [^m] )*

# Assistant content inside a wrapped turn (parent supplies both
# <|tool_calls_section_begin|> and <|im_end|> as next-sibling delimiters).
content-in-turn ::= ( [^<] | "<" [^|] | "<|" [^ti] )*
