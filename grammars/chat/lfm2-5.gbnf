# LFM2.5 chat grammar (GBNF)
#
# Covers the full output format for both tool-call and content-only responses.
# Tool call format: (optional <|tool_call_start|>) [name(arg="val",...)]

root ::= think-block? content "<|tool_call_start|>"? tool-calls?
think-block ::= "<think>" reasoning "</think>"
reasoning ::= ( [^<] | "<" [^/] )*
content ::= ( [^\[] | "<" [^|] )*

tool-calls ::= tool-call+
tool-call ::= "[" func-name "(" arg-list ")" "]"
func-name ::= [a-zA-Z_] [a-zA-Z0-9_]*
arg-list ::= ( named-arg ( "," named-arg )* )?
named-arg ::= arg-name "=" arg-value
arg-name ::= [a-zA-Z_] [a-zA-Z0-9_]*
arg-value ::= quoted-string | lfm-number | "True" | "False" | "None"
quoted-string ::= "\"" ( [^"\\] | "\\" [^\n] )* "\""
lfm-number ::= "-"? [0-9]+ ( "." [0-9]+ )?
