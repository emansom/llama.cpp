%llguidance {}

# LFM2 chat grammar (Lark / llguidance)
#
# Covers the full output format for both tool-call and content-only responses.
# Tool call format: <|tool_call_start|>[name(arg="val",...)]<|tool_call_end|>
# Uses Python-style keyword arguments.

start: think_block? content tool_call_block?
think_block: "<think>" reasoning "</think>"
reasoning: /(.|\n)*?/
content: /([^<]|<(?!\|tool_call_start\|))*/

tool_call_block: "<|tool_call_start|>" tool_calls "<|tool_call_end|>"
tool_calls: tool_call+
tool_call: "[" func_name "(" arg_list ")" "]"
func_name: FUNC_NAME
FUNC_NAME: /[a-zA-Z_][a-zA-Z0-9_]*/
arg_list: (named_arg ("," named_arg)*)?
named_arg: ARG_NAME "=" arg_value
ARG_NAME: /[a-zA-Z_][a-zA-Z0-9_]*/
arg_value: QUOTED_STRING | LFM_NUMBER | LFM_BOOL | "None"
QUOTED_STRING: "\"" /([^"\\]|\\.)*/ "\""
LFM_NUMBER: /-?[0-9]+(\.[0-9]+)?/
LFM_BOOL: "True" | "False"

%ignore " "
