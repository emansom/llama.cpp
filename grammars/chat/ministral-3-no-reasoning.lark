%llguidance {}

# Ministral-3 chat grammar — parser-side variant for `reasoning_format = NONE`.
#
# Mirrors `ministral-3.lark` for tool-call / response-format / content turn
# shapes, but treats the `[THINK]...[/THINK]` block as content (markers
# preserved verbatim) rather than extracting it as reasoning. Selected by
# `init_ministral_3` when `inputs.reasoning_format == COMMON_REASONING_FORMAT_NONE`.
# The sampling grammar is unchanged (llguidance still constrains the model
# to the full Ministral-3 format).
#
# Two named entries (same as ministral-3.lark):
#   - `start` (default) — assistant-turn continuation; sampler entry.
#   - `conversation` — full conversation wire shape; selected via arena
#     set_root() by the bidirectional walker.
#
# {{TOOL_SCHEMA}}     replaced at runtime with per-tool %json {schema} rules.
# {{RESPONSE_SCHEMA}} replaced at runtime with %json {response_schema} rule.

# `think_block` is NOT tagged (would leak partial '[T' from the literal as
# content during streaming). The body is captured via 'analysis_content'
# which IS tagged as content by lark-to-peg; the literal '[THINK]' /
# '[/THINK]' markers are emitted by the per-format Ministral-3 transformer
# as synthetic content text wrapping the body, so the surface content has
# the markers preserved exactly as the test expects.
start: think_block? content (tool_call_section | response_format | )

# --- Assistant turn continuation (sampler entry) -------------------------------
think_block: "[THINK]" analysis_content "[/THINK]"
analysis_content: /(.|\n)*?/
content: /([^\[`]|(?!\[TOOL_CALLS\])\[|(?!```json)`|``(?!`))*/

tool_call_section: tool_call+
tool_call: "[TOOL_CALLS]" func_name "[ARGS]" tool_args
func_name: FUNC_NAME
FUNC_NAME: /[a-zA-Z_][a-zA-Z0-9_]*/
tool_args: {{TOOL_SCHEMA}}

response_format: "```json\n" response_content "\n```"
response_content: {{RESPONSE_SCHEMA}}

# --- Full-conversation walker entry --------------------------------------------
# Identical to `ministral-3.lark` — the no-reasoning variant only changes how
# the assistant-turn `[THINK]` block is surfaced; the conversation wire shape
# is the same.
conversation: system_prompt_block? available_tools_block? entry+
entry: user_inst | tool_results | assistant_inline_text
user_inst:               "[INST]"            entry_body_text "[/INST]"
tool_results:            "[TOOL_RESULTS]"    entry_body_text "[/TOOL_RESULTS]"
system_prompt_block:     "[SYSTEM_PROMPT]"   entry_body_text "[/SYSTEM_PROMPT]"
available_tools_block:   "[AVAILABLE_TOOLS]" entry_body_text "[/AVAILABLE_TOOLS]"

entry_body_text: /([^\[]|\[(?!\/))*/
assistant_inline_text: /(.|\n)*?/

%ignore " "
