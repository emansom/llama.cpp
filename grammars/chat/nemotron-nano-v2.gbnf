# Nemotron-Nano-v2 chat grammar (GBNF)

root ::= assistant-body
assistant-body ::= content tool-calls-block? eot?
content ::= ( [^<] | "<" [^T] | "<T" [^O] )*

tool-calls-block ::= "<TOOLCALL>[" json-ws tool-call ( "," json-ws tool-call )* json-ws "]</TOOLCALL>"
json-ws ::= ( " " | "\t" | "\n" )*
tool-call ::= "{\"name\": \"" func-name "\", \"arguments\": " tool-args "}"
func-name ::= [a-zA-Z_] [a-zA-Z0-9_]*
tool-args ::= "{" ( [^}] | "{" [^}]* "}" )* "}"

eot ::= "<SPECIAL_12>"
